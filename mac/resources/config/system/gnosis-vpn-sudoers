# Gnosis VPN Service Management
# No service account: these users manage the service without a password.
# postinstall renders __CONSOLE_USER__ as the console user; it names them directly because creating a group writes
# to Directory Services, which macOS 27 gates behind an "Installer would like to administer your computer" prompt.
# %gnosisvpn keeps the group older installers created working, and is how further users get access.
User_Alias GNOSISVPN_USERS = %gnosisvpn, __CONSOLE_USER__

# Allow Gnosis VPN users to control the Gnosis VPN service
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl bootstrap system /Library/LaunchDaemons/com.gnosisvpn.gnosisvpnclient.plist
# A failed identity migration leaves the service disabled; the app runs enable, then bootstrap.
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl enable system/com.gnosisvpn.gnosisvpnclient
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl bootout system /Library/LaunchDaemons/com.gnosisvpn.gnosisvpnclient.plist
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl kickstart system/com.gnosisvpn.gnosisvpnclient
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl kill SIGTERM system/com.gnosisvpn.gnosisvpnclient
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl kill SIGINT system/com.gnosisvpn.gnosisvpnclient
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl print system/com.gnosisvpn.gnosisvpnclient

# Allow Gnosis VPN users to check service status
GNOSISVPN_USERS ALL=(root) NOPASSWD: /bin/launchctl list com.gnosisvpn.gnosisvpnclient

# Allow Gnosis VPN users to run the self-updater, spawned by the app as:
#   sudo -n /usr/local/bin/gnosis_vpn-update update --output json --channel <stable|snapshot|experimental> [--force]
# Argument forms are enumerated exactly, in the order the app passes them; sudo
# matches argv literally, so extend this in lockstep with the app's invocation.
# The experimental entries land ahead of the toolkit and app learning the channel.
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --output json --channel stable
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --output json --channel stable --force
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --output json --channel snapshot
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --output json --channel snapshot --force
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --output json --channel experimental
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --output json --channel experimental --force

# Retained for app builds that predate --output json (and for a rollback).
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --channel stable
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --channel stable --force
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --channel snapshot
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --channel snapshot --force
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --channel experimental
GNOSISVPN_USERS ALL=(root) NOPASSWD: /usr/local/bin/gnosis_vpn-update update --channel experimental --force
