version = 7

[pix_strategy]
price_per_byte = "9 000 000 000 wei wxHOPR"
max_ssa_allocation = "9 wxHOPR"
deposit_buffer_period = "500ms"
max_deposit_tracking_time = "3m"
max_deposit_retries = 3
funding_min_available = "6 wxHOPR"
funding_top_up = "35.35 wxHOPR"

[connection.path_planner]
# Prune to the 3 fastest candidate paths; the client preset keeps every relayer (0).
min_paths_anonymity_floor = 3

[connection.pix.dimensions]
# Pinned to the exits' geometry so a hoprnet default change cannot desync client and exit.
num_ssa_parts = 4096
ssa_part_size = 32
additional_shares = 79

# Bootstrap mode: a fixed node set the app can switch to; none of it is in the gvpn:exit registry.
[bootstrap]
# The client keeps channels only to these relay nodes.
relayers = [
