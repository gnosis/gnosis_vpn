version = 7

# Each exit's country, derived from its announced address; shipped by this package.
geoip_db = "/usr/local/share/gnosisvpn/geoip.mmdb"

[pix_strategy]
price_per_byte = "0.000000000000000001 wxHOPR"
max_ssa_allocation = "0.000000001 wxHOPR"
deposit_buffer_period = "500ms"
max_deposit_tracking_time = "60s"
max_deposit_retries = 3

[connection.path_planner]
# Prune to the 3 fastest candidate paths; the client preset keeps every relayer (0).
min_paths_anonymity_floor = 3
