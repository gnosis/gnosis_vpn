version = 7

[pix_strategy]
price_per_byte = "0.00000000000001 wxHOPR"
max_ssa_allocation = "0.00001 wxHOPR"
deposit_buffer_period = "500ms"
max_deposit_tracking_time = "60s"
max_deposit_retries = 3
relayer_url = "https://api.curvy.dev"
# Float for ~150 chunks at 10 000 wei/B; the dev Safe (~0.01 wxHOPR) cannot hold the 100 wxHOPR default.
initial_funding = "0.001 wxHOPR"

[connection.path_planner]
# Prune to the 3 fastest candidate paths; the client preset keeps every relayer (0).
min_paths_anonymity_floor = 3

[connection.pix.dimensions]
# Pinned to the exits' geometry so a hoprnet default change cannot desync client and exit.
num_ssa_parts = 4096
ssa_part_size = 32
additional_shares = 79
