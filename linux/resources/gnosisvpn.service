[Unit]
Description=Gnosis VPN Service
Documentation=https://docs.vpn.gnosis.eth.limo/
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=200
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root

# Environment and configuration
EnvironmentFile=/etc/gnosisvpn/gnosisvpn.env
EnvironmentFile=-/etc/gnosisvpn/gnosisvpn-dynamic.env
WorkingDirectory=/var/lib/gnosisvpn

# Main service command
ExecStart=/usr/bin/gnosis_vpn-root

# Restart configuration
Restart=always
RestartSec=5s

# Process management
TimeoutStopSec=30
TimeoutStartSec=60

SyslogIdentifier=gnosisvpn

# /run/gnosisvpn: the control socket, the daemon lock and the crash-recovery state
RuntimeDirectory=gnosisvpn
RuntimeDirectoryMode=0755

# Security hardening for VPN service
# VPN needs CAP_NET_ADMIN for tunnel management
# CAP_SETUID/CAP_SETGID needed to spawn the worker as the requesting user
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SETUID CAP_SETGID CAP_DAC_OVERRIDE CAP_CHOWN

# File system protection
# full, not strict: the worker writes its identity under the requesting user's home, wherever that home is mounted
ProtectSystem=full
ProtectHome=no
PrivateTmp=yes

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
